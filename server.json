{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.jhostinaleck/brightspace",
  "description": "MCP server for D2L Brightspace. Access courses, grades, assignments, syllabus, announcements, calendar, and more — with multi-strategy auth, MCP Resources, MCP Prompts, and a local web dashboard.",
  "repository": {
    "url": "https://github.com/JhostinAleck/brightspace-mcp",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "brightspace-mcp",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "BRIGHTSPACE_CONFIG",
          "description": "Path to config.yaml. Default: ~/.brightspace-mcp/config.yaml",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
