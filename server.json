{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.JhostinAleck/brightspace",
  "description": "D2L Brightspace MCP server: courses, grades, rubrics, feedback, course files, calendar. Multi-auth.",
  "repository": {
    "url": "https://github.com/JhostinAleck/brightspace-mcp",
    "source": "github"
  },
  "version": "1.3.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "brightspace-mcp",
      "version": "1.3.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "BRIGHTSPACE_CONFIG",
          "description": "Path to config.yaml. Default: ~/.brightspace-mcp/config.yaml",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
